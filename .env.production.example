# DB — will run locally on EC2 (not Docker)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=monitoring_hub
DB_USER=monitor
DB_PASSWORD=changeme_do_not_use_default
# Pooled connections per worker process (this * --workers in the systemd
# ExecStart = total connections this app can hold open). Raised from a
# smaller default after the Sep 5 2026 pool-exhaustion incident -- see
# app/db.py's own module docstring for the full story before lowering this.
DB_POOL_SIZE=20

# App
APP_ENV=production
APP_PORT=8000
# Set to false on at most ONE environment (e.g. a shared dev box) if the
# same real AWS/Azure/GCP accounts are onboarded in more than one place --
# every environment with this unset/true runs its own full collector
# (scheduler, describe-poll, Azure/GCP fetch) against the same cloud
# accounts, which means duplicate API calls and duplicate cloud billing.
# Leave unset (defaults to true) on your actual production environment.
# See app/main.py's lifespan() for exactly what this gates.
COLLECTOR_ENABLED=true

# AWS (your existing keys)
AWS_DEFAULT_REGION=ap-south-1

VM_URL=http://3.109.181.40

# Session auth (Phase 0 RBAC prerequisite)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
# Provider (Azure/GCP) credential encryption-at-rest key. If left unset,
# app/credentials.py silently auto-generates and stores a key at
# config/credential.key instead -- functional, but means the key isn't
# backed up/rotatable via your normal secrets process and lives as a
# plain file on the app server. Set this explicitly in production.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
# Set to true once the app is served over HTTPS (see Security Checklist)
COOKIE_SECURE=false
# Comma-separated origins allowed to send credentialed (cookie) requests.
# In production behind Nginx (frontend+API same origin) this can just be
# the app's own URL; the defaults here cover local dev.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Rate limiting (login / forgot-password / reset-password) ──────
# Fixed-window limits backed by Redis -- see app/auth/rate_limit.py's
# module docstring for the full design (fails OPEN, not closed, if Redis
# is unreachable). All optional; these are the actual code defaults,
# shown here so they're discoverable without reading source. Login has
# two independent limits (per-IP AND per-username); forgot/reset-password
# each have one (per-IP only).
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_PER_IP_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_PER_USERNAME=10
LOGIN_RATE_LIMIT_PER_USERNAME_WINDOW_SECONDS=300
FORGOT_PASSWORD_RATE_LIMIT_PER_IP=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
RESET_PASSWORD_RATE_LIMIT_PER_IP=10
RESET_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900

# ── Outbound mail (optional) ──────────────────────────────────────
# Welcome emails (set-your-password link) on user creation, and the
# password-reset link on /api/auth/forgot-password, are both sent via
# this if SMTP_HOST is set. Leave SMTP_HOST empty/unset to disable email
# entirely -- the reset/welcome flows still work, they just log the
# token/link server-side (readable via `journalctl`, not by the HTTP
# caller) instead of emailing it. This is NOT the same as older
# documentation/commit messages describing this deployment: an earlier
# version of this code path returned the token directly in the API
# response when SMTP wasn't configured, which was a full account-
# takeover vector (any unauthenticated caller could reset any user's
# password with no proof of email ownership) -- fixed 2026-09-12. If
# you're reading an older doc/comment that says otherwise, trust this
# one and the code, not that doc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# true = STARTTLS on port 587 (typical). false = implicit TLS, port 465.
SMTP_USE_TLS=true
MAIL_FROM=cloudops@aurionpro.com
SMTP_FROM=

# ── Reports engine (S3-backed client/stakeholder reports) ─────────
# REPORTS_ENABLED: true on prod, false on dev -- see .env.example for why.
REPORTS_ENABLED=false
REPORTS_S3_BUCKET=
REPORTS_S3_KMS_KEY_ID=
REPORT_RETENTION_DAYS=365
REPORT_JOB_STUCK_TIMEOUT_MINUTES=15
# The server's real public URL, used to build the link inside emails.
PUBLIC_APP_URL=http://13.200.102.131

# ── AIOps roadmap #13/#15: LLM-polished alert summaries (2026-09-15) ──
# Off by default. Default provider is Ollama (free, local, no API key,
# no per-call cost). See .env.example's longer comment for the full
# explanation and one-time Ollama setup steps -- same variables, same
# behavior in production.
LLM_SUMMARY_ENABLED=false
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
ANTHROPIC_API_KEY=
LLM_SUMMARY_MODEL=claude-haiku-4-5-20251001
LLM_SUMMARY_TIMEOUT_SECONDS=20
LLM_SUMMARY_MAX_TOKENS=220
LLM_SUMMARY_BATCH_LIMIT=50

# ── Deploy-risk correlation webhook (2026-09-14) ───────────────────
# Off by default. See .env.example's longer comment. Point your CI/CD
# pipeline's deploy step at POST /api/webhooks/deploy with this token.
DEPLOY_WEBHOOK_TOKEN=

# ── SAML 2.0 SSO (2026-09-14) ──────────────────────────────────────
# Off by default. See .env.example's longer comment for the full
# explanation of each variable.
SSO_SAML_ENABLED=false
SSO_SP_ENTITY_ID=
SSO_SP_ACS_URL=
SSO_IDP_ENTITY_ID=
SSO_IDP_SSO_URL=
SSO_IDP_X509_CERT=
SSO_EMAIL_ATTRIBUTE=
SSO_AUTO_PROVISION=false
SSO_DEFAULT_ROLE=viewer
