diff --git a/frontend/src/components/MetricSelector.jsx b/frontend/src/components/MetricSelector.jsx
new file mode 100644
index 0000000..1043631
--- /dev/null
+++ b/frontend/src/components/MetricSelector.jsx
@@ -0,0 +1,191 @@
+// src/components/MetricSelector.jsx
+import { useState, useMemo } from "react";
+import "./MetricSelector.css";
+
+const CATEGORY_LABEL = { core: "Core", extended: "Extended", directory: "Directory (100+ AWS services)" };
+const CATEGORY_TABS = ["all", "core", "extended", "directory"];
+
+/**
+ * Reusable AWS CloudWatch metric picker.
+ *
+ * props:
+ *   catalog       — [{ service, display_service, namespace, category, metrics:[{id, metric_name, statistic, unit, description, is_default, enabled?}], directory_id }]
+ *   selectedIds   — Set<number> of currently-enabled metric ids (controlled)
+ *   onChange(nextSet) — called with a new Set whenever selection changes
+ *   onDiscover(namespace) — optional async fn; runs the live AWS discovery
+ *                            call and persists results server-side. After it
+ *                            resolves, the caller must refresh `catalog`
+ *                            (real metric ids only exist once the backend
+ *                            has written them) — this component does not
+ *                            fabricate rows client-side.
+ *   compact       — smaller service list, used inline in onboarding
+ */
+export default function MetricSelector({ catalog, selectedIds, onChange, onDiscover, compact = false }) {
+  const [search, setSearch]       = useState("");
+  const [tab, setTab]             = useState("all");
+  const [expanded, setExpanded]   = useState(() => new Set());
+  const [discovering, setDiscovering] = useState(null);
+
+  const filtered = useMemo(() => {
+    const q = search.trim().toLowerCase();
+    return (catalog || [])
+      .filter(g => tab === "all" || g.category === tab)
+      .map(g => {
+        if (!q) return g;
+        const svcMatch = (g.display_service || "").toLowerCase().includes(q);
+        const metrics = svcMatch ? g.metrics : g.metrics.filter(m =>
+          m.metric_name.toLowerCase().includes(q) ||
+          (m.description || "").toLowerCase().includes(q)
+        );
+        return { ...g, metrics };
+      })
+      .filter(g => g.metrics.length > 0 || (q && (g.display_service || "").toLowerCase().includes(q)));
+  }, [catalog, search, tab]);
+
+  const totalSelected = selectedIds.size;
+
+  function toggleMetric(id) {
+    const next = new Set(selectedIds);
+    next.has(id) ? next.delete(id) : next.add(id);
+    onChange(next);
+  }
+
+  function toggleService(group, allOn) {
+    const next = new Set(selectedIds);
+    group.metrics.forEach(m => allOn ? next.delete(m.id) : next.add(m.id));
+    onChange(next);
+  }
+
+  function toggleExpand(service) {
+    setExpanded(prev => {
+      const next = new Set(prev);
+      next.has(service) ? next.delete(service) : next.add(service);
+      return next;
+    });
+  }
+
+  function applyDefaults() {
+    const next = new Set(selectedIds);
+    (catalog || []).forEach(g => g.metrics.forEach(m => { if (m.is_default) next.add(m.id); }));
+    onChange(next);
+  }
+
+  function clearAll() {
+    onChange(new Set());
+  }
+
+  async function handleDiscover(group) {
+    if (!onDiscover) return;
+    setDiscovering(group.namespace);
+    try {
+      await onDiscover(group.namespace);   // parent refetches catalog with real ids
+      setExpanded(prev => new Set(prev).add(group.service));
+    } catch (e) {
+      console.error("Discover failed", e);
+    } finally {
+      setDiscovering(null);
+    }
+  }
+
+  return (
+    <div className={`ms-root ${compact ? "ms-compact" : ""}`}>
+      <div className="ms-toolbar">
+        <input
+          className="ms-search"
+          placeholder="Search metrics or services…"
+          value={search}
+          onChange={e => setSearch(e.target.value)}
+        />
+        <div className="ms-tabs">
+          {CATEGORY_TABS.map(t => (
+            <button
+              key={t}
+              type="button"
+              className={`ms-tab ${tab === t ? "ms-tab-active" : ""}`}
+              onClick={() => setTab(t)}
+            >
+              {t === "all" ? "All" : CATEGORY_LABEL[t]}
+            </button>
+          ))}
+        </div>
+        <div className="ms-actions">
+          <span className="ms-count">{totalSelected} selected</span>
+          <button type="button" className="ms-btn-ghost" onClick={applyDefaults}>Apply recommended</button>
+          <button type="button" className="ms-btn-ghost" onClick={clearAll}>Clear all</button>
+        </div>
+      </div>
+
+      <div className="ms-list">
+        {filtered.length === 0 && (
+          <div className="ms-empty">No metrics match "{search}".</div>
+        )}
+        {filtered.map(group => {
+          const isOpen   = expanded.has(group.service) || (search.trim() !== "");
+          const selCount = group.metrics.filter(m => selectedIds.has(m.id)).length;
+          const allOn    = group.metrics.length > 0 && selCount === group.metrics.length;
+          const isDirectoryEmpty = group.category === "directory" && group.metrics.length === 0;
+
+          return (
+            <div key={group.service} className="ms-group">
+              <button type="button" className="ms-group-header" onClick={() => toggleExpand(group.service)}>
+                <span className={`ms-chevron ${isOpen ? "ms-chevron-open" : ""}`}>▸</span>
+                <span className="ms-group-name">{group.display_service}</span>
+                <span className={`ms-badge ms-badge-${group.category}`}>{group.category}</span>
+                <span className="ms-namespace">{group.namespace}</span>
+                <span className="ms-spacer" />
+                {group.metrics.length > 0 && (
+                  <>
+                    <span className="ms-group-count">{selCount}/{group.metrics.length}</span>
+                    <span
+                      className="ms-select-all"
+                      onClick={(e) => { e.stopPropagation(); toggleService(group, allOn); }}
+                    >
+                      {allOn ? "Deselect all" : "Select all"}
+                    </span>
+                  </>
+                )}
+              </button>
+
+              {isOpen && (
+                <div className="ms-group-body">
+                  {isDirectoryEmpty && (
+                    <div className="ms-discover-row">
+                      <span className="ms-discover-hint">
+                        Metric names for this service aren't pre-loaded — discover what your account actually publishes.
+                      </span>
+                      {onDiscover ? (
+                        <button
+                          type="button"
+                          className="ms-btn-ghost"
+                          disabled={discovering === group.namespace}
+                          onClick={() => handleDiscover(group)}
+                        >
+                          {discovering === group.namespace ? "Discovering…" : "Discover metrics"}
+                        </button>
+                      ) : (
+                        <span className="ms-discover-hint-sub">Available after the account is onboarded (Settings → Metrics).</span>
+                      )}
+                    </div>
+                  )}
+                  {group.metrics.map(m => (
+                    <label key={m.id} className="ms-metric-row">
+                      <input
+                        type="checkbox"
+                        checked={selectedIds.has(m.id)}
+                        onChange={() => toggleMetric(m.id)}
+                      />
+                      <span className="ms-metric-name">{m.metric_name}</span>
+                      <span className="ms-metric-stat">{m.statistic}{m.unit ? ` · ${m.unit}` : ""}</span>
+                      {m.description && <span className="ms-metric-desc">{m.description}</span>}
+                      {m.is_default && <span className="ms-default-tag">recommended</span>}
+                    </label>
+                  ))}
+                </div>
+              )}
+            </div>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
