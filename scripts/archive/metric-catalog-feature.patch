+# app/aws/metric_catalog_data.py
+"""
+Source-of-truth for the CloudWatch metric catalog.
+
+Two tiers:
+
+  CURATED   — services with a hand-enumerated metric list (name, unit,
+              statistic, short description, whether it's part of the
+              recommended default onboarding template). Includes the
+              'core' services this app already collects (EC2, EBS, RDS,
+              ALB, Lambda, S3, ECS) plus the most commonly monitored
+              'extended' AWS services.
+
+  DIRECTORY — every remaining AWS service that publishes CloudWatch
+              metrics (from "AWS services that publish CloudWatch
+              metrics", the official AWS namespace list). These are
+              registered by namespace only — individual metric names are
+              fetched on demand per account/region via the CloudWatch
+              ListMetrics API ("Discover" in the UI) rather than
+              hand-typed here, since AWS adds/changes these constantly
+              and only a fraction will exist in any one account.
+
+Run `python scripts/seed_metric_catalog.py` after editing this file to
+push changes into the `metric_catalog` table.
+"""
+
+# service key -> (display name, namespace, category, [ (metric_name, unit, statistic, is_default, description), ... ])
+CURATED = {
+
+    # ── Core (already collected today) ───────────────────────────
+    "ec2": ("Amazon EC2", "AWS/EC2", "core", [
+        ("CPUUtilization",     "Percent", "Average", True,  "% CPU used"),
+        ("NetworkIn",          "Bytes",   "Sum",     True,  "Inbound network traffic"),
+        ("NetworkOut",         "Bytes",   "Sum",     True,  "Outbound network traffic"),
+        ("DiskReadBytes",      "Bytes",   "Sum",     False, "Instance-store disk reads"),
+        ("DiskWriteBytes",     "Bytes",   "Sum",     False, "Instance-store disk writes"),
+        ("StatusCheckFailed",  "Count",   "Maximum", True,  "Combined instance+system health check"),
+        ("StatusCheckFailed_Instance", "Count", "Maximum", False, "Instance-level health check"),
+        ("StatusCheckFailed_System",   "Count", "Maximum", False, "Underlying host health check"),
+        ("CPUCreditUsage",     "Count",   "Sum",     False, "Burstable (T-class) CPU credits used"),
+        ("CPUCreditBalance",   "Count",   "Average", False, "Burstable (T-class) CPU credits available"),
+        ("EBSReadOps",         "Count",   "Sum",     False, "EBS read operations"),
+        ("EBSWriteOps",        "Count",   "Sum",     False, "EBS write operations"),
+        ("EBSReadBytes",       "Bytes",   "Sum",     False, "EBS bytes read"),
+        ("EBSWriteBytes",      "Bytes",   "Sum",     False, "EBS bytes written"),
+        ("MetadataNoToken",    "Count",   "Sum",     False, "IMDSv1 requests (no token) — security signal"),
+    ]),
+    "ebs": ("Amazon EBS", "AWS/EBS", "core", [
+        ("VolumeReadOps",       "Count",   "Average", True,  "Read operations/sec"),
+        ("VolumeWriteOps",      "Count",   "Average", True,  "Write operations/sec"),
+        ("VolumeReadBytes",     "Bytes",   "Average", False, "Bytes read"),
+        ("VolumeWriteBytes",    "Bytes",   "Average", False, "Bytes written"),
+        ("VolumeQueueLength",   "Count",   "Average", True,  "I/O requests waiting — bottleneck signal"),
+        ("BurstBalance",        "Percent", "Average", True,  "gp2 burst credit balance"),
+        ("VolumeIdleTime",      "Seconds", "Average", False, "Time volume was idle"),
+        ("VolumeThroughputPercentage",  "Percent", "Average", False, "io1/io2 throughput used vs provisioned"),
+        ("VolumeConsumedReadWriteOps",  "Count",   "Average", False, "Consumed IOPS toward provisioned limit"),
+        ("VolumeTotalReadTime",  "Seconds", "Average", False, "Total seconds spent on read ops"),
+        ("VolumeTotalWriteTime", "Seconds", "Average", False, "Total seconds spent on write ops"),
+    ]),
+    "rds": ("Amazon RDS", "AWS/RDS", "core", [
+        ("CPUUtilization",        "Percent", "Average", True,  "% CPU used"),
+        ("DatabaseConnections",   "Count",   "Average", True,  "Active DB connections"),
+        ("FreeStorageSpace",      "Bytes",   "Average", True,  "Remaining allocated storage"),
+        ("ReadIOPS",              "Count/Second", "Average", True,  "Read I/O operations/sec"),
+        ("WriteIOPS",             "Count/Second", "Average", True,  "Write I/O operations/sec"),
+        ("ReadLatency",           "Seconds", "Average", True,  "Avg time per read op"),
+        ("WriteLatency",          "Seconds", "Average", True,  "Avg time per write op"),
+        ("FreeableMemory",        "Bytes",   "Average", True,  "RAM available to the DB engine"),
+        ("SwapUsage",             "Bytes",   "Average", False, "Swap space used"),
+        ("DiskQueueDepth",        "Count",   "Average", False, "Outstanding I/O requests"),
+        ("ReplicaLag",            "Seconds", "Average", False, "Read-replica lag behind primary"),
+        ("BinLogDiskUsage",       "Bytes",   "Average", False, "MySQL/MariaDB binlog disk usage"),
+        ("TransactionLogsDiskUsage", "Bytes", "Average", False, "PostgreSQL WAL disk usage"),
