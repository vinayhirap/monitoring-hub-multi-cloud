# Local development environment template.
#
# This file didn't exist in the repo at all before now -- nothing else
# in the codebase references it by name, but .env.example is the
# universal convention for "copy this to .env and fill in the blanks"
# for local dev, so its absence meant a new contributor had no local
# starting point beyond .env.production.example (which documents
# production-specific hardening that doesn't apply to a laptop). See
# that file for the same variables explained in more depth; this one
# trims the production-only guidance and swaps a few values for sane
# local-dev defaults.
#
# Copy this file to .env, then fill in DB_PASSWORD and generate a real
# JWT_SECRET (see below) before running the app.

# ── Database ────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=monitoring_hub
DB_USER=monitor
DB_PASSWORD=changeme_do_not_use_default
# Fine to leave at the default for local dev (a single dev instance
# never needs anywhere near this many connections).
DB_POOL_SIZE=20

# ── App ─────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
# Leave at the default (true) for a normal single-instance local dev
# setup. Only relevant if you're intentionally running two instances
# against the same onboarded cloud accounts -- see
# .env.production.example's longer explanation of what this gates.
COLLECTOR_ENABLED=true

# ── Cloud provider defaults ─────────────────────────────────────
AWS_DEFAULT_REGION=ap-south-1
# Legacy VictoriaMetrics/YACE endpoint -- most of this app's metric
# collection has moved to direct cloud-API fetches (see
# app/collector/metrics_vm_sync.py's module docstring for the full
# migration history); this is only still consulted by a few describe-
# polling code paths. Safe to leave pointing at a real shared test
# server if your team has one, or leave as-is if you don't use it.
VM_URL=http://3.109.181.40

# ── Session auth (required -- no insecure fallback exists) ────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# ── Provider (Azure/GCP) credential encryption-at-rest ───────────
# If left unset, app/credentials.py silently auto-generates and stores
# a key at config/credential.key instead -- fine for local dev (that
# file is gitignored), but if you ever onboard a real Azure/GCP account
# locally, set this explicitly so you don't lose access to its stored
# secrets if config/credential.key ever gets deleted.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ── Cookies / CORS ──────────────────────────────────────────────
# Local dev is never served over HTTPS -- leave this false. Only ever
# set to true once actually deployed behind real TLS.
COOKIE_SECURE=false
# Matches Vite's default dev server ports.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Rate limiting (login / forgot-password / reset-password) ──────
# Fixed-window limits backed by Redis -- see app/auth/rate_limit.py's
# module docstring for the full design (fails OPEN, not closed, if
# Redis is unreachable, so these are safe to leave unset for local dev
# even without Redis running). These are the actual code defaults,
# shown here so they're discoverable without reading source.
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_PER_IP_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_PER_USERNAME=10
LOGIN_RATE_LIMIT_PER_USERNAME_WINDOW_SECONDS=300
FORGOT_PASSWORD_RATE_LIMIT_PER_IP=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
RESET_PASSWORD_RATE_LIMIT_PER_IP=10
RESET_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900

# ── Outbound mail (optional -- safe to leave entirely unset for local dev) ──
# Welcome emails (set-your-password link) on user creation, and the
# password-reset link on /api/auth/forgot-password, are both sent via
# this if SMTP_HOST is set. Leave SMTP_HOST empty/unset to disable email
# entirely -- the reset/welcome flows still work, they just log the
# token/link server-side (visible in your local terminal/log output, not
# returned to the HTTP caller) instead of emailing it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=cloudops@aurionpro.com
# Used to build the link inside emails -- point at wherever your local
# frontend dev server actually runs.
PUBLIC_APP_URL=http://localhost:5173

# ── AIOps roadmap #13/#15: LLM-polished alert summaries (2026-09-14) ──
# Off by default -- both of these must be set for
# app/collector/llm_summarizer.py to ever run or make a network call.
# See app/llm/summarizer.py's module docstring for the fact-grounding /
# graceful-fallback contract. Uses the Anthropic Messages API
# (api.anthropic.com) -- a small per-alert cost applies once enabled,
# bounded per cycle by LLM_SUMMARY_BATCH_LIMIT below.
LLM_SUMMARY_ENABLED=false
ANTHROPIC_API_KEY=
# claude-haiku-4-5-20251001 is fast/cheap and sufficient for rewording
# already-verified facts -- no need for a larger model here.
LLM_SUMMARY_MODEL=claude-haiku-4-5-20251001
LLM_SUMMARY_TIMEOUT_SECONDS=8
LLM_SUMMARY_MAX_TOKENS=220
# Max alerts refreshed per "low" tier cycle -- caps worst-case API
# spend per cycle; a large backlog catches up gradually over several
# cycles instead of all at once.
LLM_SUMMARY_BATCH_LIMIT=50
