# Local development environment template.
#
# This file didn't exist in the repo at all before now -- nothing else
# in the codebase references it by name, but .env.example is the
# universal convention for "copy this to .env and fill in the blanks"
# for local dev, so its absence meant a new contributor had no local
# starting point beyond .env.production.example (which documents
# production-specific hardening that doesn't apply to a laptop). See
# that file for the same variables explained in more depth; this one
# trims the production-only guidance and swaps a few values for sane
# local-dev defaults.
#
# Copy this file to .env, then fill in DB_PASSWORD and generate a real
# JWT_SECRET (see below) before running the app.

# ── Database ────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=monitoring_hub
DB_USER=monitor
DB_PASSWORD=changeme_do_not_use_default
# Fine to leave at the default for local dev (a single dev instance
# never needs anywhere near this many connections).
DB_POOL_SIZE=20

# ── App ─────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
# Leave at the default (true) for a normal single-instance local dev
# setup. Only relevant if you're intentionally running two instances
# against the same onboarded cloud accounts -- see
# .env.production.example's longer explanation of what this gates.
COLLECTOR_ENABLED=true

# ── Cloud provider defaults ─────────────────────────────────────
AWS_DEFAULT_REGION=ap-south-1
# Legacy VictoriaMetrics/YACE endpoint -- most of this app's metric
# collection has moved to direct cloud-API fetches (see
# app/collector/metrics_vm_sync.py's module docstring for the full
# migration history); this is only still consulted by a few describe-
# polling code paths. Safe to leave pointing at a real shared test
# server if your team has one, or leave as-is if you don't use it.
VM_URL=http://3.109.181.40

# ── Session auth (required -- no insecure fallback exists) ────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# ── Provider (Azure/GCP) credential encryption-at-rest ───────────
# If left unset, app/credentials.py silently auto-generates and stores
# a key at config/credential.key instead -- fine for local dev (that
# file is gitignored), but if you ever onboard a real Azure/GCP account
# locally, set this explicitly so you don't lose access to its stored
# secrets if config/credential.key ever gets deleted.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ── Cookies / CORS ──────────────────────────────────────────────
# Local dev is never served over HTTPS -- leave this false. Only ever
# set to true once actually deployed behind real TLS.
COOKIE_SECURE=false
# Matches Vite's default dev server ports.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Rate limiting (login / forgot-password / reset-password) ──────
# Fixed-window limits backed by Redis -- see app/auth/rate_limit.py's
# module docstring for the full design (fails OPEN, not closed, if
# Redis is unreachable, so these are safe to leave unset for local dev
# even without Redis running). These are the actual code defaults,
# shown here so they're discoverable without reading source.
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_PER_IP_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_PER_USERNAME=10
LOGIN_RATE_LIMIT_PER_USERNAME_WINDOW_SECONDS=300
FORGOT_PASSWORD_RATE_LIMIT_PER_IP=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
RESET_PASSWORD_RATE_LIMIT_PER_IP=10
RESET_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900

# ── Outbound mail (optional -- safe to leave entirely unset for local dev) ──
# Welcome emails (set-your-password link) on user creation, and the
# password-reset link on /api/auth/forgot-password, are both sent via
# this if SMTP_HOST is set. Leave SMTP_HOST empty/unset to disable email
# entirely -- the reset/welcome flows still work, they just log the
# token/link server-side (visible in your local terminal/log output, not
# returned to the HTTP caller) instead of emailing it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=cloudops@aurionpro.com
# SMTP_FROM is accepted too (alias) -- app/reports (client report
# emailing) documents the var as SMTP_FROM; either name works.
SMTP_FROM=

# ── Reports engine (S3-backed client/stakeholder reports) ─────────
# Dedicated bucket -- do NOT point this at a bucket used for anything
# else. Leave REPORTS_S3_KMS_KEY_ID empty to use SSE-S3 (AES256); set
# it to use SSE-KMS with a customer-managed key instead. See the AWS
# S3 setup guide for bucket policy / lifecycle / IAM.
REPORTS_S3_BUCKET=
REPORTS_S3_KMS_KEY_ID=
REPORT_RETENTION_DAYS=365
REPORT_JOB_STUCK_TIMEOUT_MINUTES=15
# Used to build the link inside emails -- point at wherever your local
# frontend dev server actually runs.
PUBLIC_APP_URL=http://localhost:5173

# ── AIOps roadmap #13/#15: LLM-polished alert summaries (2026-09-15) ──
# Off by default. DEFAULT PROVIDER IS OLLAMA -- free forever, runs
# locally on this server, no API key, no per-call cost of any kind.
# See app/llm/summarizer.py's module docstring for one-time Ollama
# install steps and the fact-grounding/graceful-fallback contract.
LLM_SUMMARY_ENABLED=false
# "ollama" (default, free/local) or "anthropic" (optional, real
# per-call cost -- only used if you explicitly set this to "anthropic"
# AND provide ANTHROPIC_API_KEY below).
LLM_PROVIDER=ollama
# Only read when LLM_PROVIDER=ollama. Defaults shown are correct for a
# same-box `ollama serve` -- change OLLAMA_HOST if Ollama runs
# elsewhere, or OLLAMA_MODEL to any model you've pulled
# (`ollama pull <name>`) for a size/quality tradeoff.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Only read when LLM_PROVIDER=anthropic -- leave both blank for the
# free local path.
ANTHROPIC_API_KEY=
LLM_SUMMARY_MODEL=claude-haiku-4-5-20251001
# 20s default -- local CPU inference is slower than a hosted API;
# raise this if a bigger Ollama model is timing out.
LLM_SUMMARY_TIMEOUT_SECONDS=20
LLM_SUMMARY_MAX_TOKENS=220
# Max alerts refreshed per "low" tier cycle -- bounds how long that
# cycle takes (free or not, local inference still takes real time per
# call); a large backlog catches up gradually over several cycles.
LLM_SUMMARY_BATCH_LIMIT=50

# ── Deploy-risk correlation webhook (2026-09-14) ───────────────────
# Off by default -- POST /api/webhooks/deploy returns 503 until this is
# set. Point your CI/CD's deploy step at this endpoint with this token
# in an X-Webhook-Token header (see app/api/webhooks.py's docstring for
# a full curl example) to let rca.py correlate alerts against deploys.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DEPLOY_WEBHOOK_TOKEN=

# ── SAML 2.0 SSO (2026-09-14) ──────────────────────────────────────
# Off by default -- every /api/auth/sso/* endpoint returns 503 until
# SSO_SAML_ENABLED=true AND the IdP settings below are all filled in.
# See app/auth/saml.py's module docstring for the full design.
SSO_SAML_ENABLED=false
# This app's own identity as a SAML Service Provider -- can be any
# unique URI your IdP will accept, commonly this app's own base URL.
SSO_SP_ENTITY_ID=
# Must exactly match this router's ACS route:
# https://<your-app-domain>/api/auth/sso/acs
SSO_SP_ACS_URL=
# From your IdP's app-integration setup screen (Okta/Azure AD/OneLogin
# all show these three values when you create a new SAML app there).
SSO_IDP_ENTITY_ID=
SSO_IDP_SSO_URL=
# The IdP's signing certificate, PEM body only (no -----BEGIN/END-----
# lines, no newlines) -- copy exactly as your IdP displays it.
SSO_IDP_X509_CERT=
# Leave empty to use the SAML NameID (configured as email format) as
# the user's email. Set to an attribute name (e.g. "email" or
# "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")
# if your IdP sends email as a separate assertion attribute instead.
SSO_EMAIL_ATTRIBUTE=
# If true, a first-time SSO login with no matching local users.email
# auto-creates an account with role=SSO_DEFAULT_ROLE. If false (safer
# default), SSO login is rejected for anyone without a pre-existing
# account -- an admin must create the user (with a matching email)
# first via the normal user-management screen.
SSO_AUTO_PROVISION=false
SSO_DEFAULT_ROLE=viewer
